{
  "name": "simple-rtsp-recorder",
  "version": "1.1.0",
  "main": "index.js",
  "scripts": {
    "start": "cross-env ENV_FILE=.env node server.js",
    "prod": "cross-env ENV_FILE=prod.env node server.js",
    "pack": "rimraf dist && pkg . && cp -r install-scripts-win/* dist",
    "bump": "commit-and-tag-version"
  },
  "bin": {
    "simple-rtsp-recorder": "server.js"
  },
  "pkg": {
    "scripts": "server.js",
    "assets": ["public/**/*"],
    "targets": [
      "latest-win-x64"
    ],
    "outputPath": "dist"
  },
  "keywords": [
    "rtsp",
    "recorder"
  ],
  "author": "joaoopereira",
  "license": "None",
  "description": "simple web server to record file from an rtsp camera stream",
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.22.1",
    "fluent-ffmpeg": "^2.1.3",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "pkg": "5.8.1",
    "rimraf": "^6.0.1",
    "commit-and-tag-version": "12.6.1"
  }
}
