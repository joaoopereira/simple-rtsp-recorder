{
	"name": "simple-rtsp-recorder",
	"image": "mcr.microsoft.com/devcontainers/javascript-node",
	"features": {
		"ghcr.io/devcontainers-extra/features/ffmpeg-apt-get": {},
		"ghcr.io/stuartleeks/dev-container-features/shell-history": {},
		"ghcr.io/nils-geistmann/devcontainers-features/zsh": {
			"theme": "robbyrussell",
			"plugins": "git history npm"
		}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"AndyGongea.update-now"
			]
		}
	},
	"postCreateCommand": "npm ci"
}
